NODE_ENV=development
PORT=4000
HOST=127.0.0.1
DATABASE_URL=postgresql://sukamaju:change-this-local-password@127.0.0.1:5433/sukamaju_peduli
# Docker Compose memakai password ini; gunakan password volume lama jika sudah ada.
POSTGRES_PASSWORD=change-this-local-password
FRONTEND_ORIGIN=http://127.0.0.1:3000
SESSION_HOURS=12
# Hanya pengujian lokal. Seed ditolak bila NODE_ENV=production.
ALLOW_DEMO_SEED=false
SEED_PASSWORD=

# Port backend Docker pada host (port internal tetap 4000).
DOCKER_BACKEND_PORT=4002
